// Cloudflare deploy settings for Rowbusters (rowbusters.com).
// Cloudflare "Workers & Pages → Import a repository" reads this file and deploys on every push.
// One Worker serves both the game files (the repo root, minus what .assetsignore lists) and the
// online rooms and ranking (server/worker.js: /lobby, /ws/room/<n>, /health).
// rowbusters.com is attached in the dashboard: Worker → Settings → Domains & Routes → Custom domain.
// (GitHub Pages still serves a copy, which sends players on to rowbusters.com.)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Keep this name: it is the server address (blocksnet.fmlacerda.workers.dev) and the home of
  // the ranking database; a new name would deploy a separate, empty server.
  "name": "blocksnet",
  "main": "server/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // Pull-request previews get a link: https://<branch>-blocksnet.fmlacerda.workers.dev
  // (takes effect once this is deployed from main).
  "preview_urls": true,
  // Game files. A request that matches a file is served directly; anything else (/lobby,
  // /ws/room/<n>, /health) goes to server/worker.js.
  "assets": { "directory": "." },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "observability": { "enabled": true },
  // Sign-in providers (server/auth.js). Client ids are public, not secrets; empty = that button is
  // hidden. APPLE_CLIENT_IDS: the Services ID for the web, then the app's bundle id.
  "vars": {
    "APPLE_CLIENT_IDS": "com.rowbusters.web,com.rowbusters.app",
    "GOOGLE_CLIENT_ID": "360016718949-oa1b23bq0krbauk2tv91nepvhdmtgt8d.apps.googleusercontent.com",
    "MICROSOFT_CLIENT_ID": "64f313de-5c79-4191-b64c-3282a9a41f97"
  },
  // Previews: every pull request gets its own copy at a workers.dev address (Cloudflare runs
  // `wrangler preview` for non-production branches). Each preview gets a NEW, empty database
  // (Durable Object namespace), never the live ranking. Bindings are not inherited, so HUB is
  // declared again here.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "HUB", "class_name": "Hub" }]
    }
  },
  // Test copy for trying changes before players see them: its own Worker, address and empty
  // ranking (https://rowbusters-staging.fmlacerda.workers.dev). Deployed with
  // `npm run deploy:staging`, or by a second Cloudflare build that watches the `staging` branch.
  "env": {
    "staging": {
      "name": "rowbusters-staging",
      "workers_dev": true,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [{ "name": "HUB", "class_name": "Hub" }]
      }
    }
  }
}
